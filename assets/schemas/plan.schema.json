{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrozenWorkPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "spec_sha256", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "spec_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "ac_ids", "mandatory"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "ac_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^AC[0-9]+$" } },
          "mandatory": { "type": "boolean" }
        }
      }
    }
  }
}
